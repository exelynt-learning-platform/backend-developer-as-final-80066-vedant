# Server
SERVER_PORT=8080

# Database — PostgreSQL (default)
DB_URL=jdbc:postgresql://localhost:5432/booking_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DRIVER=org.postgresql.Driver
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Database — MySQL (alternative). Uncomment and adjust if using MySQL instead:
# DB_URL=jdbc:mysql://localhost:3306/booking_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
# DB_USERNAME=root
# DB_PASSWORD=root
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# DB_DIALECT=org.hibernate.dialect.MySQLDialect

DDL_AUTO=update
SHOW_SQL=false

# JWT
JWT_SECRET=ChangeThisSuperSecretKeyForJwtSigningMinimum256BitsLong123456
JWT_EXPIRATION_MS=86400000

# Seed data (created on startup if not already present)
SEED_DATA=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123
SEED_USER_USERNAME=user
SEED_USER_PASSWORD=User@123
